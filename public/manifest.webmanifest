{
  "id": "/",
  "name": "Vita Express",
  "short_name": "Vita",
  "description": "Commandez et suivez vos livraisons Vita Express à Kinshasa.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/auth/login?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0d0d0d",
  "theme_color": "#0d0d0d",
  "categories": ["business", "navigation", "utilities"],
  "icons": [
    {
      "src": "/vita-mark-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/vita-mark-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/vita-mark-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Commander",
      "short_name": "Commander",
      "url": "/dashboard/order",
      "icons": [{ "src": "/vita-mark-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Suivre un colis",
      "short_name": "Suivi",
      "url": "/tracking",
      "icons": [{ "src": "/vita-mark-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
